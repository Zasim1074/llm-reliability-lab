DATABASE_URL=sqlite:///./llm_reliability_local.db
DATABASE_SSL_MODE=
CORS_ORIGINS=http://localhost:3000
CACHE_SIMILARITY_THRESHOLD=0.82
CACHE_TTL_SECONDS=86400
CACHE_SCAN_LIMIT=2000
DEMO_MODE=true
APP_ACCESS_TOKEN=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CLIENT_CAPACITY=10000
REQUEST_BODY_MAX_BYTES=1000000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
LLM_PROVIDER=demo
EMBEDDING_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
PROVIDER_TIMEOUT_SECONDS=30
# Set both token prices to enable provider cost estimates.
# LLM_INPUT_COST_PER_MILLION=0.15
# LLM_OUTPUT_COST_PER_MILLION=0.60
# Set embedding model input token price separately for cache benchmark cost estimates.
# EMBEDDING_COST_PER_MILLION=0.02
ESTIMATED_LLM_CALL_COST_USD=0.002
