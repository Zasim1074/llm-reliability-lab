# Browser-facing URL: used by JavaScript running in the user's browser.
BROWSER_API_BASE_URL=http://localhost:8000/api/v1
WEB_PORT=3000
API_PORT=8000
WEB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1

# SQLite is the default for a local demo. For the optional PostgreSQL profile,
# set DATABASE_URL to postgresql+psycopg://reliability:<password>@db:5432/reliability
DATABASE_URL=sqlite:////data/llm_reliability.db
DATABASE_SSL_MODE=
CORS_ORIGINS=http://localhost:3000
DEMO_MODE=true
APP_ACCESS_TOKEN=

# Optional hosted provider settings. Keep OPENAI_API_KEY server-side only.
LLM_PROVIDER=demo
EMBEDDING_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
PROVIDER_TIMEOUT_SECONDS=30
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=
EMBEDDING_COST_PER_MILLION=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_BODY_MAX_BYTES=1000000

# Used only with `docker compose --profile postgres up`.
POSTGRES_DB=reliability
POSTGRES_USER=reliability
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DB_PORT=5432
DB_BIND_ADDRESS=127.0.0.1
